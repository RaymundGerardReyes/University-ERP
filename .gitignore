# ==============================================================================
# University ERP Full-Stack .gitignore
# Covering: C# .NET 9, Avalonia UI (Offline LMS), React TS Monorepo, 
#           Cloudflare (Terraform), Nginx (SSL Keys), and Local DBs
# ==============================================================================

# =========================
# 1. Operating System Files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# =========================
# 2. Node.js & React (TypeScript Monorepo)
# =========================
# Dependencies & Package Managers
node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/
/.pnp
.pnp.js

# Vite & TS Build Caches
.vite/
*.tsbuildinfo

# Build outputs (Apps & Libraries)
dist/
build/
out/
storybook-static/
University-ERP-Frontend/apps/**/*.js
!University-ERP-Frontend/apps/**/vite.config.js

# Logs, Coverage & E2E/Performance Test Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
coverage/
playwright-report/
blob-report/
test-results/
.lighthouseci/

# =========================
# 3. C# .NET 9 & Avalonia UI (LMS Offline)
# =========================
# Build results
**/[Bb]in/
**/[Oo]bj/

# Publish, Deployments & Test outputs
**/[Pp]ublish/
[Tt]est[Rr]esults/
win-x64/
win-arm64/
linux-x64/
osx-x64/

# Crash dumps, Logs & Runtime Diagnostics
*.dmp
*.dump
app.log
crash.log
*.log

# Local SQLite & SQLCipher Offline Databases (Avalonia Client)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.mdf
*.ldf

# Local Development & One-off Migration Utility Scripts
University-ERP-Frontend/clients/lms-offline-avalonia/*.ps1

# IDE / Visual Studio / Rider / VS Code
.vs/
.idea/
*.sln.docstates
*.user
*.userprefs
*.suo
*.rsuser

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# =========================
# 4. Ops, DevOps & Security (Cloudflare & Nginx)
# =========================
# Terraform (ops/cloudflare/dns)
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl
crash.log

# SSL / TLS Certificates & Private Keys (ops/nginx/ssl)
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
ops/nginx/ssl/*.crt
ops/nginx/ssl/*.key

# Docker & Container local overrides
docker-compose.override.yml

# =========================
# 5. Environment & Secrets Configuration
# =========================
.env
.env.local
.env.development
.env.production
.env.testing
.env.keys

!.env.example

appsettings.Development.json
appsettings.*.user.json
secrets.json*.md
