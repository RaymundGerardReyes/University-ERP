# -----------------------------------------------------------------------------
# University ERP - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env and populate with production values before running
# docker compose up -d --build
# -----------------------------------------------------------------------------

# PostgreSQL Configuration
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=universityerp
DB_USER=erp_admin
DB_PASSWORD=SecureProductionPassword123!

# Global ASP.NET Core Settings
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# Cloudflare Zero Trust Tunnel
# -----------------------------------------------------------------------------
# Obtain this token from Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-from-zero-trust-dashboard

# Security Settings
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_strong_random_key_here_for_production_use
JWT_ISSUER=https://auth.university.edu
JWT_AUDIENCE=university-erp-api

# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_ENDPOINT=http://prometheus:9090
GRAFANA_ADMIN_PASSWORD=SecureGrafanaPassword123!

# Note: Cloudflare DNS and WAF configuration is managed 
# separately in University-ERP-Backend/ops/cloudflare/ via Terraform.
