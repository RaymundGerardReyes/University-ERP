# -----------------------------------------------------------------------------
# University ERP - Unified Frontend Builder
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Leverage Docker layer caching by copying manifests first
COPY package.json package-lock.json* ./
COPY apps/admin-portal/package.json ./apps/admin-portal/
COPY apps/admissions-portal/package.json ./apps/admissions-portal/
COPY apps/applicant-portal/package.json ./apps/applicant-portal/
COPY apps/faculty-portal/package.json ./apps/faculty-portal/
COPY apps/finance-console/package.json ./apps/finance-console/
COPY apps/governance-console/package.json ./apps/governance-console/
COPY apps/identity-portal/package.json ./apps/identity-portal/
COPY apps/library-portal/package.json ./apps/library-portal/
COPY apps/lms-web/package.json ./apps/lms-web/
COPY apps/platform-console/package.json ./apps/platform-console/
COPY apps/registrar-portal/package.json ./apps/registrar-portal/
COPY apps/security-portal/package.json ./apps/security-portal/
COPY apps/student-portal/package.json ./apps/student-portal/
COPY libs/api-clients/package.json ./libs/api-clients/
COPY libs/auth-sdk/package.json ./libs/auth-sdk/
COPY libs/core-logger/package.json ./libs/core-logger/
COPY libs/domain-viewmodels/package.json ./libs/domain-viewmodels/
COPY libs/shell-kit/package.json ./libs/shell-kit/
COPY libs/ui-kit/package.json ./libs/ui-kit/
COPY libs/vite-config/package.json ./libs/vite-config/
COPY libs/workflow-sdk/package.json ./libs/workflow-sdk/

RUN npm install

# Copy source code
COPY . .

# Accept shared Vite arguments
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_AUTH_AUTHORITY
ENV VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY
ARG VITE_IDENTITY_PORTAL_URL
ENV VITE_IDENTITY_PORTAL_URL=$VITE_IDENTITY_PORTAL_URL
ARG VITE_APPLICANT_PORTAL_URL
ENV VITE_APPLICANT_PORTAL_URL=$VITE_APPLICANT_PORTAL_URL
ARG VITE_STUDENT_PORTAL_URL
ENV VITE_STUDENT_PORTAL_URL=$VITE_STUDENT_PORTAL_URL
ARG VITE_FACULTY_PORTAL_URL
ENV VITE_FACULTY_PORTAL_URL=$VITE_FACULTY_PORTAL_URL
ARG VITE_FINANCE_CONSOLE_URL
ENV VITE_FINANCE_CONSOLE_URL=$VITE_FINANCE_CONSOLE_URL
ARG VITE_GOVERNANCE_CONSOLE_URL
ENV VITE_GOVERNANCE_CONSOLE_URL=$VITE_GOVERNANCE_CONSOLE_URL
ARG VITE_ADMIN_PORTAL_URL
ENV VITE_ADMIN_PORTAL_URL=$VITE_ADMIN_PORTAL_URL
ARG VITE_LIBRARY_PORTAL_URL
ENV VITE_LIBRARY_PORTAL_URL=$VITE_LIBRARY_PORTAL_URL
ARG VITE_LMS_WEB_URL
ENV VITE_LMS_WEB_URL=$VITE_LMS_WEB_URL
ARG VITE_REGISTRAR_PORTAL_URL
ENV VITE_REGISTRAR_PORTAL_URL=$VITE_REGISTRAR_PORTAL_URL
ARG VITE_SECURITY_PORTAL_URL
ENV VITE_SECURITY_PORTAL_URL=$VITE_SECURITY_PORTAL_URL
ARG VITE_ADMISSIONS_PORTAL_URL
ENV VITE_ADMISSIONS_PORTAL_URL=$VITE_ADMISSIONS_PORTAL_URL
ARG VITE_PAYMENT_GATEWAY_URL
ENV VITE_PAYMENT_GATEWAY_URL=$VITE_PAYMENT_GATEWAY_URL
ARG VITE_PLATFORM_CONSOLE_URL
ENV VITE_PLATFORM_CONSOLE_URL=$VITE_PLATFORM_CONSOLE_URL

# Build all portals sequentially to avoid Docker daemon memory exhaustion
RUN mkdir -p /app/dist-temp \
    && npm run build --workspace=apps/admin-portal && mv /app/apps/admin-portal/dist /app/dist-temp/admin-portal \
    && npm run build --workspace=apps/admissions-portal && mv /app/apps/admissions-portal/dist /app/dist-temp/admissions-portal \
    && npm run build --workspace=apps/applicant-portal && mv /app/apps/applicant-portal/dist /app/dist-temp/applicant-portal \
    && npm run build --workspace=apps/faculty-portal && mv /app/apps/faculty-portal/dist /app/dist-temp/faculty-portal \
    && npm run build --workspace=apps/finance-console && mv /app/apps/finance-console/dist /app/dist-temp/finance-console \
    && npm run build --workspace=apps/governance-console && mv /app/apps/governance-console/dist /app/dist-temp/governance-console \
    && npm run build --workspace=apps/identity-portal && mv /app/apps/identity-portal/dist /app/dist-temp/identity-portal \
    && npm run build --workspace=apps/library-portal && mv /app/apps/library-portal/dist /app/dist-temp/library-portal \
    && npm run build --workspace=apps/lms-web && mv /app/apps/lms-web/dist /app/dist-temp/lms-web \
    && npm run build --workspace=apps/platform-console && mv /app/apps/platform-console/dist /app/dist-temp/platform-console \
    && npm run build --workspace=apps/registrar-portal && mv /app/apps/registrar-portal/dist /app/dist-temp/registrar-portal \
    && npm run build --workspace=apps/security-portal && mv /app/apps/security-portal/dist /app/dist-temp/security-portal \
    && npm run build --workspace=apps/student-portal && mv /app/apps/student-portal/dist /app/dist-temp/student-portal

# -----------------------------------------------------------------------------
# Stage 2: Immutable Delivery Container
# -----------------------------------------------------------------------------
FROM alpine:latest

# Copy the compiled assets from the builder stage
COPY --from=builder /app/dist-temp /app-data

# Copy assets to the shared volume mount point and exit gracefully
CMD echo "🚚 Delivering compiled React files to Nginx volumes..." \
    && cp -a /app-data/* /output/ \
    && echo "✅ Delivery complete! Container exiting successfully."
