# -----------------------------------------------------------------------------
# University ERP - Frontend Builder (Pattern B)
# -----------------------------------------------------------------------------
# This Dockerfile builds all 8 Vite portals and copies their output into a
# volume structure that matches the Nginx named volume expectations.
# -----------------------------------------------------------------------------

FROM node:22-alpine AS builder

WORKDIR /app
# Copy workspace manifests first to leverage Docker layer caching
COPY package.json package-lock.json ./
COPY apps/admin-portal/package.json ./apps/admin-portal/
COPY apps/admissions-portal/package.json ./apps/admissions-portal/
COPY apps/applicant-portal/package.json ./apps/applicant-portal/
COPY apps/faculty-portal/package.json ./apps/faculty-portal/
COPY apps/finance-console/package.json ./apps/finance-console/
COPY apps/governance-console/package.json ./apps/governance-console/
COPY apps/identity-portal/package.json ./apps/identity-portal/
COPY apps/library-portal/package.json ./apps/library-portal/
COPY apps/lms-web/package.json ./apps/lms-web/
COPY apps/platform-console/package.json ./apps/platform-console/
COPY apps/registrar-portal/package.json ./apps/registrar-portal/
COPY apps/security-portal/package.json ./apps/security-portal/
COPY apps/student-portal/package.json ./apps/student-portal/

COPY libs/api-clients/package.json ./libs/api-clients/
COPY libs/auth-sdk/package.json ./libs/auth-sdk/
COPY libs/core-logger/package.json ./libs/core-logger/
COPY libs/domain-viewmodels/package.json ./libs/domain-viewmodels/
COPY libs/shell-kit/package.json ./libs/shell-kit/
COPY libs/ui-kit/package.json ./libs/ui-kit/
COPY libs/vite-config/package.json ./libs/vite-config/
COPY libs/workflow-sdk/package.json ./libs/workflow-sdk/

# Install dependencies before copying source code
RUN npm ci

# Copy the rest of the source code
COPY . .

# Accept build arguments from docker-compose
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

ARG VITE_AUTH_AUTHORITY
ENV VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY

ARG VITE_IDENTITY_PORTAL_URL
ENV VITE_IDENTITY_PORTAL_URL=$VITE_IDENTITY_PORTAL_URL

# --- ADD THESE TWO LINES ---
ARG VITE_APPLICANT_PORTAL_URL
ENV VITE_APPLICANT_PORTAL_URL=$VITE_APPLICANT_PORTAL_URL

# Build all portals simultaneously
RUN npm run build --workspaces --if-present

# We do NOT run Nginx inside this container. 
# This container's ONLY job is to copy the built files into named volumes 
# before exiting (restart: "no" in docker-compose).
CMD echo "🚚 Delivering compiled React files to Nginx volumes..." && \
    cp -a /app/apps/identity-portal/dist/* /output/identity-portal/ && \
    cp -a /app/apps/student-portal/dist/* /output/student-portal/ && \
    cp -a /app/apps/faculty-portal/dist/* /output/faculty-portal/ && \
    cp -a /app/apps/admin-portal/dist/* /output/admin-portal/ && \
    cp -a /app/apps/lms-web/dist/* /output/lms-web/ && \
    cp -a /app/apps/finance-console/dist/* /output/finance-console/ && \
    cp -a /app/apps/library-portal/dist/* /output/library-portal/ && \
    cp -a /app/apps/governance-console/dist/* /output/governance-console/ && \
    cp -a /app/apps/platform-console/dist/* /output/platform-console/ && \
    cp -a /app/apps/applicant-portal/dist/* /output/applicant-portal/ && \
    cp -a /app/apps/admissions-portal/dist/* /output/admissions-portal/ && \
    cp -a /app/apps/registrar-portal/dist/* /output/registrar-portal/ && \
    cp -a /app/apps/security-portal/dist/* /output/security-portal/ && \
    echo "✅ Delivery complete! Container exiting successfully."
