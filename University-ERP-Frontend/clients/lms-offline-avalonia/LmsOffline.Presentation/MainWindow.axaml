<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LmsOffline.Presentation.Views"
        x:Class="LmsOffline.Presentation.MainWindow"
        Title="University ERP - Offline LMS Client"
        Width="1024" Height="768">

    <TabControl Margin="10">
        <TabItem Header="Module Timeline (Sync)">
            <views:ModuleTimelineView />
        </TabItem>
        <TabItem Header="Offline Assessment">
            <views:AssessmentView />
        </TabItem>
        <TabItem Header="Homework Submission">
            <views:AssignmentSubmissionView />
        </TabItem>
    </TabControl>
</Window>