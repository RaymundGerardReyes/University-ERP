<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LmsOffline.Presentation.ViewModels"
        xmlns:controls="using:LmsOffline.Presentation.Views.CustomControls"
        xmlns:shell="using:LmsOffline.Presentation.Shell"
        x:Class="LmsOffline.Presentation.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="University ERP - Student Learning Portal"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBase}"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        CornerRadius="{StaticResource RadiusWindow}"
        WindowState="Normal">

    <Window.Styles>
        <!-- Style to automatically bind IsExpanded to our Node Model -->
        <Style Selector="TreeViewItem" x:DataType="vm:TaxonomyNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="36,*,Auto">
        
        <controls:CustomTitleBar Grid.Row="0" />

        <SplitView Grid.Row="1" x:Name="MainSplitView"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="280"
                   CompactPaneLength="68"
                   Background="{DynamicResource BgBase}">
            
            <!-- Navigation Sidebar Pane Extracted -->
            <SplitView.Pane>
                <shell:AppSidebar />
            </SplitView.Pane>

            <!-- Main Content Area -->
            <SplitView.Content>
                <Border Background="{DynamicResource BgBase}">
                    <Grid>
                        <Border MaxWidth="1600" HorizontalAlignment="Stretch">
                            <TransitioningContentControl Content="{Binding CurrentPage}" />
                        </Border>
                    </Grid>
                </Border>
            </SplitView.Content>
        </SplitView>

        <!-- Live Bottom Status Bar Extracted -->
        <shell:AppStatusBar Grid.Row="2" />
        
    </Grid>
</Window>