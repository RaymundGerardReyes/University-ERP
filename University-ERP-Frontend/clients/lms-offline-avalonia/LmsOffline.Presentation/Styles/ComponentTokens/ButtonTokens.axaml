<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
      BUTTON TOKENS 
      Enforces optical nesting for interactive action buttons.
    -->
    <StaticResource x:Key="ButtonRadius" ResourceKey="RadiusMD" />
    <Thickness x:Key="ButtonPadding">16,10</Thickness>
    <StaticResource x:Key="ButtonElevation" ResourceKey="ShadowLevel1" />

</ResourceDictionary>
