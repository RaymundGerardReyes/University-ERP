<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
      INPUT TOKENS 
      Enforces optical nesting for form inputs.
    -->
    <StaticResource x:Key="InputRadius" ResourceKey="Radius10" />
    <Thickness x:Key="InputPadding">14,10</Thickness>
    <StaticResource x:Key="InputBorderThickness" ResourceKey="BorderStandard" />

</ResourceDictionary>
