<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            
            <!-- 3-TIER SURFACE DEPTH MODEL -->
            <!-- Window Level (Deepest) -->
            <SolidColorBrush x:Key="BgBase" Color="{StaticResource Slate50}" />
            
            <!-- Panel Level (Mid) -->
            <SolidColorBrush x:Key="BgPanel" Color="{StaticResource Slate100}" />
            
            <!-- Card Level (Highest) -->
            <SolidColorBrush x:Key="BgSurface" Color="{StaticResource White}" />
            
            <!-- TEXT HIERARCHY -->
            <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource Slate900}" />
            <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource Slate500}" />
            <SolidColorBrush x:Key="TextMuted" Color="{StaticResource Slate400}" />
            <SolidColorBrush x:Key="TextBright" Color="{StaticResource White}" />
            <SolidColorBrush x:Key="TextAccent" Color="{StaticResource Indigo600}" />

            <!-- BRAND HIERARCHY -->
            <SolidColorBrush x:Key="BrandPrimary" Color="{StaticResource Indigo600}" />
            <SolidColorBrush x:Key="BrandHover" Color="{StaticResource Indigo700}" />

            <!-- STRUCTURAL BORDERS -->
            <SolidColorBrush x:Key="BorderColor" Color="{StaticResource Slate300}" />
            <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource Slate200}" />

            <!-- SEMANTIC STATUS (Base, Hover, Subtle/Background) -->
            <SolidColorBrush x:Key="SuccessBase" Color="{StaticResource Emerald600}" />
            <SolidColorBrush x:Key="SuccessHover" Color="{StaticResource Emerald700}" />
            <SolidColorBrush x:Key="SuccessSubtle" Color="{StaticResource Emerald50}" />

            <SolidColorBrush x:Key="WarningBase" Color="{StaticResource Yellow600}" />
            <SolidColorBrush x:Key="WarningHover" Color="{StaticResource Yellow700}" />
            <SolidColorBrush x:Key="WarningSubtle" Color="{StaticResource Yellow50}" />

            <SolidColorBrush x:Key="ErrorBase" Color="{StaticResource Red600}" />
            <SolidColorBrush x:Key="ErrorHover" Color="{StaticResource Red700}" />
            <SolidColorBrush x:Key="ErrorSubtle" Color="{StaticResource Red50}" />

            <SolidColorBrush x:Key="InfoBase" Color="{StaticResource Sky500}" />
            <SolidColorBrush x:Key="InfoHover" Color="{StaticResource Sky600}" />
            <SolidColorBrush x:Key="InfoSubtle" Color="{StaticResource Sky50}" />
            
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
