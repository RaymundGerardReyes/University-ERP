<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             xmlns:shared="using:LmsOffline.Presentation.Shared.Controls"
             x:Class="LmsOffline.Presentation.Shell.AppStatusBar"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,8" IsVisible="{Binding IsLoggedIn}">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{Binding ToggleNetworkModeCommand}"
                        Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource TextBright}" CornerRadius="{DynamicResource BadgeRadius}" Padding="10,4" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{Binding NetworkStatusColor}"/>
                        <TextBlock Text="{Binding NetworkStatus}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleThemeCommand}"
                        Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource BadgeRadius}" Padding="10,4" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Toggle Theme" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Offline Learning Mode Active. Your progress will auto-sync when online."
                       Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Using Phase 2 Shared StatusBadges -->
                <shared:StatusBadge Text="  Secured" 
                                    BgColor="{DynamicResource BgPanel}" 
                                    BorderColor="{DynamicResource BorderColor}" 
                                    FgColor="{DynamicResource SuccessBase}"/>
                                    
                <shared:StatusBadge Text="{Binding PendingOutboxCount, StringFormat='  {0} Pending Uploads'}" 
                                    BgColor="{DynamicResource BgPanel}" 
                                    BorderColor="{DynamicResource BorderColor}" 
                                    FgColor="{DynamicResource BrandHover}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
