<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Inner element radius mathematically scaled: Outer (24) - Padding (10) = 14 -->
    <CornerRadius x:Key="InputRadius">14</CornerRadius>
    <Thickness x:Key="InputPadding">14,10</Thickness>
    <StaticResource x:Key="InputBorderThickness" ResourceKey="BorderStandard" />
</ResourceDictionary>
