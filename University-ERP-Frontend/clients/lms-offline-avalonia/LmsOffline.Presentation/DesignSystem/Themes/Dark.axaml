<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            
            <!-- 3-TIER SURFACE DEPTH MODEL -->
            <SolidColorBrush x:Key="BgBase" Color="#0F172A" />      <!-- Slate900 -->
            <SolidColorBrush x:Key="BgPanel" Color="#1E293B" />     <!-- Slate800 -->
            <SolidColorBrush x:Key="BgSurface" Color="#334155" />   <!-- Slate700 -->
            
            <!-- TEXT HIERARCHY -->
            <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" /> <!-- Slate50 -->
            <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1" /><!-- Slate300 -->
            <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />   <!-- Slate400 -->
            <SolidColorBrush x:Key="TextBright" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextAccent" Color="#818CF8" />  <!-- Indigo400 -->

            <!-- BRAND HIERARCHY -->
            <SolidColorBrush x:Key="BrandPrimary" Color="#6366F1" /><!-- Indigo500 -->
            <SolidColorBrush x:Key="BrandHover" Color="#818CF8" />  <!-- Indigo400 -->
            <SolidColorBrush x:Key="BrandSubtle" Color="#1A6366F1" /> <!-- Indigo500 @ 10% -->

            <!-- STRUCTURAL BORDERS -->
            <SolidColorBrush x:Key="BorderColor" Color="#475569" /> <!-- Slate600 -->
            <SolidColorBrush x:Key="BorderSubtle" Color="#334155" /><!-- Slate700 -->

            <!-- SEMANTIC STATUS -->
            <SolidColorBrush x:Key="SuccessBase" Color="#10B981" />
            <SolidColorBrush x:Key="SuccessHover" Color="#34D399" />
            <SolidColorBrush x:Key="SuccessSubtle" Color="#1A10B981" />
            
            <SolidColorBrush x:Key="WarningBase" Color="#F59E0B" />
            <SolidColorBrush x:Key="WarningHover" Color="#FBBF24" />
            <SolidColorBrush x:Key="WarningSubtle" Color="#1AF59E0B" />

            <SolidColorBrush x:Key="ErrorBase" Color="#EF4444" />
            <SolidColorBrush x:Key="ErrorHover" Color="#F87171" />
            <SolidColorBrush x:Key="ErrorSubtle" Color="#1AEF4444" />

            <SolidColorBrush x:Key="InfoBase" Color="#0EA5E9" />
            <SolidColorBrush x:Key="InfoHover" Color="#38BDF8" />
            <SolidColorBrush x:Key="InfoSubtle" Color="#1A0EA5E9" />
            
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
