<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 
      TYPOGRAPHY PRIMITIVES
      Base sizes and generic font families. 
      Do not define semantic roles here (e.g. FontSizePageTitle). Map to ComponentTokens.
    -->
    
    <!-- Base Scale -->
    <sys:Double x:Key="Size12">12</sys:Double>
    <sys:Double x:Key="Size14">14</sys:Double>
    <sys:Double x:Key="Size16">16</sys:Double>
    <sys:Double x:Key="Size22">22</sys:Double>
    <sys:Double x:Key="Size32">32</sys:Double>

</ResourceDictionary>
