<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LmsOffline.Presentation.Shared.Controls.StatusBadge"
             x:Name="Root">
    <Border Background="{Binding BgColor, ElementName=Root}" 
            BorderBrush="{Binding BorderColor, ElementName=Root}" 
            BorderThickness="1" 
            CornerRadius="{DynamicResource BadgeRadius}" 
            Padding="8,3">
        <TextBlock Text="{Binding Text, ElementName=Root}" 
                   Foreground="{Binding FgColor, ElementName=Root}" 
                   FontSize="11" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
