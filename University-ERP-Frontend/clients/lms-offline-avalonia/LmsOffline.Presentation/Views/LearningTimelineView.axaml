<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.LearningTimelineView"
             x:DataType="vm:LearningTimelineViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource SpacingLargeVal}" Margin="{DynamicResource SpacingLarge}">
            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource SpacingMicroVal}">
                    <TextBlock Text="Learning Timeline" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
                    <TextBlock Text="Track your offline course progression, completed lessons, and upcoming assessments." Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource ButtonRadius}" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
                </Border>
            </Grid>

            <!-- Course Modules Cards List -->
            <ItemsControl ItemsSource="{Binding CourseModules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:OfflineCourseModuleItem">
                        <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{DynamicResource InfoSubtle}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1" CornerRadius="{DynamicResource BadgeRadius}" Padding="8,3">
                                            <TextBlock Text="{Binding CourseCode}" Foreground="{DynamicResource InfoHover}" FontWeight="Bold" FontSize="{DynamicResource FontSizeMetadata}"/>
                                        </Border>
                                        <TextBlock Text="{Binding ModuleTitle}" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Instructor, StringFormat='Instructor: {0}'}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>

                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding NextMilestone, StringFormat='Next Milestone: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="{DynamicResource SuccessBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource InfoBase}" CornerRadius="3"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="View Syllabus" 
                                        Command="{Binding $parent[UserControl].((vm:LearningTimelineViewModel)DataContext).SelectModuleCommand}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextBright}" FontWeight="SemiBold"
                                        VerticalAlignment="Center" Margin="20,0,0,0" Padding="14,10" CornerRadius="{DynamicResource ButtonRadius}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected Module Timeline Detail -->
            <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1">
                <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                    <TextBlock Text="Active Module Milestones" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource InfoHover}"/>

                    <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource ButtonRadius}" Padding="{DynamicResource SpacingMedium}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="LESSON 1 • COMPLETED" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBase}"/>
                                <TextBlock Text="Introduction to Encrypted Local Cache &amp; Domain Model" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextBright}" FontWeight="SemiBold"/>
                                <TextBlock Text="Duration: 45 mins • Offline Video Saved" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Replay Lesson" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextBright}" VerticalAlignment="Center" Padding="12,8" CornerRadius="{DynamicResource BadgeRadius}"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource ButtonRadius}" Padding="{DynamicResource SpacingMedium}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ASSESSMENT • PENDING" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource WarningBase}"/>
                                <TextBlock Text="Midterm Security &amp; Outbox Pattern Exam" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextBright}" FontWeight="SemiBold"/>
                                <TextBlock Text="Time Limit: 60 mins • AES-256 Token Locked" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Start Exam" Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" VerticalAlignment="Center" Padding="14,8" CornerRadius="{DynamicResource BadgeRadius}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>