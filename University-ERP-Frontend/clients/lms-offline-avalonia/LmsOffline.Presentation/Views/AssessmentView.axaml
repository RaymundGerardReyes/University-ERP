<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:DataType="vm:AssessmentViewModel"
             x:Class="LmsOffline.Presentation.Views.AssessmentView">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="University ERP - Offline Assessment" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"/>
        
        <!-- Binds to the StatusMessage property in the ViewModel -->
        <TextBlock Text="{Binding StatusMessage}" 
                   Foreground="DarkSlateBlue" 
                   FontSize="16"
                   HorizontalAlignment="Center"/>
        
        <!-- Binds to the StartAssessmentCommand in the ViewModel -->
        <Button Content="Start Offline Exam Securely" 
                Command="{Binding StartAssessmentCommand}" 
                HorizontalAlignment="Center" 
                Padding="15,10"
                Background="Green"
                Foreground="White"/>
    </StackPanel>
</UserControl>
