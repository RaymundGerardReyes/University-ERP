<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:DataType="vm:AssessmentViewModel"
             x:Class="LmsOffline.Presentation.Views.AssessmentView">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Width="500">
        <TextBlock Text="University ERP - Offline Assessment" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        
        <TextBlock Text="{Binding StatusMessage}" Foreground="DarkSlateBlue" FontSize="16" HorizontalAlignment="Center"/>
        
        <Button Content="Start Offline Exam Securely" 
                Command="{Binding StartAssessmentCommand}" 
                HorizontalAlignment="Center" Padding="15,10" Background="Green" Foreground="White"/>

        <!-- Exam Input Area (Enabled after starting) -->
        <TextBlock Text="Exam Answers (JSON payload format for demo):" FontWeight="SemiBold" Margin="0,20,0,0"/>
        
        <TextBox Text="{Binding AnswersJson}" 
                 AcceptsReturn="True" 
                 Height="150" 
                 TextWrapping="Wrap" 
                 Watermark="[ { 'QuestionId': 'Q1', 'SelectedOption': 'A' } ]"/>
        
        <Button Content="Submit Securely to Outbox" 
                Command="{Binding SubmitAssessmentCommand}" 
                HorizontalAlignment="Right" Padding="15,10" Background="DarkRed" Foreground="White"/>
    </StackPanel>
</UserControl>