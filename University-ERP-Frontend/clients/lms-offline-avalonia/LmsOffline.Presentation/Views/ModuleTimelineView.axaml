<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LmsOffline.Presentation.Views.ModuleTimelineView">
    
    <StackPanel Spacing="15" Padding="20">
        <TextBlock Text="Module Timeline (Offline Mode)" 
                   FontSize="22" 
                   FontWeight="Bold"/>
        
        <TextBlock Text="These are your securely downloaded modules and their strict cryptographic availability windows." 
                   TextWrapping="Wrap"/>
        
        <!-- Example of an active assessment module -->
        <Border BorderBrush="LightGray" BorderThickness="1" Padding="15" CornerRadius="5" Background="White">
            <StackPanel Spacing="5">
                <TextBlock Text="Advanced Mathematics Midterm" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Status: Downloaded / Ready" Foreground="Green"/>
                <TextBlock Text="Strict Window: Oct 10, 08:00 AM - Oct 12, 08:00 PM (UTC)" Foreground="DarkRed" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
