<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:DataType="vm:ModuleTimelineViewModel"
             x:Class="LmsOffline.Presentation.Views.ModuleTimelineView">
    
    <StackPanel Spacing="15" Padding="20">
        <TextBlock Text="Module Timeline (Offline Mode)" FontSize="22" FontWeight="Bold"/>
        
        <TextBlock Text="These are your securely downloaded modules and their strict cryptographic availability windows." TextWrapping="Wrap"/>
        
        <!-- Live Status Binding -->
        <TextBlock Text="{Binding SyncStatusMessage}" Foreground="DarkSlateBlue" FontWeight="SemiBold" TextWrapping="Wrap"/>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Download Latest Packages" 
                    Command="{Binding DownloadPackageCommand}" 
                    Background="Teal" Foreground="White" Padding="15,10"/>
            
            <Button Content="Sync Outbox to ERP" 
                    Command="{Binding SyncNowCommand}" 
                    Background="DarkBlue" Foreground="White" Padding="15,10"/>
        </StackPanel>

        <Border BorderBrush="LightGray" BorderThickness="1" Padding="15" CornerRadius="5" Background="White" Margin="0,10,0,0">
            <StackPanel Spacing="5">
                <TextBlock Text="Advanced Mathematics Midterm" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="Status: Downloaded / Ready" Foreground="Green"/>
                <TextBlock Text="Strict Window: Oct 10, 08:00 AM - Oct 12, 08:00 PM (UTC)" Foreground="DarkRed" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>