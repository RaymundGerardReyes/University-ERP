<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:DataType="vm:AssignmentSubmissionViewModel"
             x:Class="LmsOffline.Presentation.Views.AssignmentSubmissionView">
    
    <StackPanel Spacing="15" Padding="20">
        <TextBlock Text="Offline Assignment Submission" FontSize="22" FontWeight="Bold" Foreground="DarkSlateBlue"/>
        
        <TextBlock Text="Type your answers below. Your work is encrypted via SQLCipher and saved locally. It will auto-sync via the Outbox Processor when internet connectivity is restored." TextWrapping="Wrap"/>
        
        <!-- Live Status Binding -->
        <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontWeight="SemiBold"/>
        
        <!-- Rich Text / Markdown Draft Area -->
        <TextBox Height="250" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 Text="{Binding DraftContent}"
                 Watermark="Enter your essay, code, or answers here..."/>
        
        <!-- Command Binding -->
        <Button Content="Save to Offline Outbox" 
                Command="{Binding SubmitAssignmentCommand}"
                Background="DarkBlue" 
                Foreground="White" 
                HorizontalAlignment="Right" 
                Padding="15,10"/>
    </StackPanel>
</UserControl>