<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource SpacingLargeVal}" Margin="{DynamicResource SpacingLarge}">
            <!-- Header Section & Self Test Button -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource SpacingMicroVal}">
                    <TextBlock Text="Diagnostics &amp; Security Vault" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
                    <TextBlock Text="Verify system health, local SQLCipher database status, and inspect runtime app.log." Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🛡️ Run System Self-Test" 
                        Command="{Binding RunSelfTestCommand}"
                        Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" 
                        VerticalAlignment="Center" Padding="14,10" CornerRadius="{DynamicResource ButtonRadius}"/>
            </Grid>

            <!-- Status Banner -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource ButtonRadius}" Padding="14,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <TextBlock Text="{Binding SystemHealthStatus}" Foreground="{DynamicResource InfoBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
            </Border>

            <!-- Security & Database Metrics -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Subsystem Security Status" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource InfoHover}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Local Storage Encryption Engine" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding EncryptionStatus}" Foreground="{DynamicResource SuccessBase}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Encrypted SQLite Database (lms_offline.db)" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DatabaseSizeBytes}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Offline JWT Auth Token Cache" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TokenValidity}" Foreground="{DynamicResource SuccessBase}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Runtime Log Terminal (app.log Reader) -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Runtime Diagnostics Feed (app.log)" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBright}"/>
                        <Button Grid.Column="1" Content="Refresh Logs" 
                                Command="{Binding LoadAppLogsCommand}"
                                Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextBright}" FontSize="{DynamicResource FontSizeMetadata}" Padding="10,4" CornerRadius="{DynamicResource BadgeRadius}"/>
                    </Grid>

                    <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource ButtonRadius}" Padding="14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" MinHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RuntimeLogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource SuccessHover}" FontSize="{DynamicResource FontSizeMetadata}" FontFamily="Consolas" Margin="0,0,0,5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>