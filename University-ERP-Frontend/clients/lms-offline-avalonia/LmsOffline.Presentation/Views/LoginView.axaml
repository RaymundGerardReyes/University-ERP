<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource BgBase}">

    <Grid>
        <!-- Centered Adaptive Card -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="480" 
                Background="{DynamicResource BgSurface}" 
                CornerRadius="{DynamicResource CardRadius}" 
                Padding="{DynamicResource SpacingSection}" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1">
            
            <StackPanel Spacing="{DynamicResource SpacingLargeVal}">
                <!-- Header & Subtitle -->
                <StackPanel Spacing="{DynamicResource SpacingSmallVal}" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource InfoSubtle}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1" CornerRadius="{DynamicResource BadgeRadius}" Padding="12,6" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="OFFLINE ACCESS" Foreground="{DynamicResource InfoHover}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" LetterSpacing="1"/>
                    </Border>
                    <TextBlock Text="Student Portal" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Access your local courses and assessments." Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Dynamic Status / Error Indicator -->
                <Border IsVisible="{Binding HasStatusMessage}" 
                        Background="{DynamicResource BgPanel}" 
                        CornerRadius="{DynamicResource CardRadius}" 
                        Padding="16,12" 
                        BorderBrush="{Binding StatusBorderColor}" 
                        BorderThickness="1">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusTextColor}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Input Fields -->
                <StackPanel Spacing="20">
                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="Institutional Email" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBox Text="{Binding Username}" 
                                 IsEnabled="{Binding !IsAuthenticating}"
                                 Background="{DynamicResource BgPanel}" 
                                 Foreground="{DynamicResource TextPrimary}" 
                                 BorderBrush="{DynamicResource BorderSubtle}" 
                                 CornerRadius="{DynamicResource InputRadius}" 
                                 FontSize="{DynamicResource FontSizeBody}"
                                 Padding="14,12"
                                 PlaceholderText="e.g. alex.rivera@university.edu"/>      
                    </StackPanel>

                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="Security PIN" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBox Text="{Binding Password}" 
                                 IsEnabled="{Binding !IsAuthenticating}"
                                 PasswordChar="•" 
                                 Background="{DynamicResource BgPanel}" 
                                 Foreground="{DynamicResource TextPrimary}" 
                                 BorderBrush="{DynamicResource BorderSubtle}" 
                                 CornerRadius="{DynamicResource InputRadius}" 
                                 FontSize="{DynamicResource FontSizeBody}"
                                 Padding="14,12"
                                 PlaceholderText="Enter your PIN"/>      
                    </StackPanel>
                </StackPanel>

                <!-- Action Toolbar -->
                <Button Command="{Binding AuthenticateCommand}" 
                        IsEnabled="{Binding !IsAuthenticating}"
                        Background="{DynamicResource BrandPrimary}" 
                        Foreground="{DynamicResource TextBright}" 
                        FontWeight="Bold" 
                        FontSize="{DynamicResource FontSizeBody}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        Padding="16,14" 
                        CornerRadius="{DynamicResource ButtonRadius}"
                        Margin="0,8,0,0">
                    <Panel>
                        <!-- Default State -->
                        <TextBlock Text="Sign In" IsVisible="{Binding !IsAuthenticating}" HorizontalAlignment="Center"/>
                        <!-- Loading State -->
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsAuthenticating}" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Foreground="{DynamicResource TextBright}" Theme="{DynamicResource ProgressRing}"/>
                            <TextBlock Text="Authenticating..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Panel>
                </Button>

                <!-- Footer Status -->
                <TextBlock Text="Sessions automatically expire after 24 hours of inactivity." 
                           Foreground="{DynamicResource TextMuted}" 
                           FontSize="{DynamicResource FontSizeMetadata}" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>