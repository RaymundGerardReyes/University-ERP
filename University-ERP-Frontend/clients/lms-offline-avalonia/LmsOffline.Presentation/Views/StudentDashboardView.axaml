<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             xmlns:dash="using:LmsOffline.Application.Features.Dashboard"
             x:Class="LmsOffline.Presentation.Views.StudentDashboardView"
             x:DataType="vm:StudentDashboardViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{DynamicResource SpacingMediumVal}" Margin="{DynamicResource SpacingLarge}">
            
            <!-- 1. COMPACT HERO HEADER -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="{DynamicResource SpacingSmallVal}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingSmallVal}">
                        <Border Background="{DynamicResource SuccessSubtle}" CornerRadius="{DynamicResource BadgeRadius}" Padding="6,2">
                            <TextBlock Text="OFFLINE ACCESS" Foreground="{DynamicResource SuccessBase}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding AcademicProgram}" Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeMetadata}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StudentName, StringFormat='Welcome back, {0}'}" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <!-- Search Input Mockup -->
                <TextBox Grid.Column="1" Width="280" Height="36" Margin="0,0,16,0"
                         Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="{DynamicResource InputRadius}"
                         Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"
                         PlaceholderText="Search modules, assignments..."/>

                <!-- Compact Avatar -->
                <Border Grid.Column="2" Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="12,8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource BrandPrimary}">
                            <TextBlock Text="AR" Foreground="{DynamicResource TextBright}" FontSize="{DynamicResource FontSizeMetadata}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StudentId, StringFormat='ID: {0}'}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. QUICK RESUME COMPACT BAR -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="16,12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="⚡ QUICK RESUME:" Foreground="{DynamicResource TextAccent}" FontSize="{DynamicResource FontSizeMetadata}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastActiveLessonTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Continue Learning" 
                            Command="{Binding ResumeLastLessonCommand}"
                            Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontWeight="Medium" 
                            Padding="16,8" CornerRadius="{DynamicResource ButtonRadius}" FontSize="{DynamicResource FontSizeMetadata}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. REFLOWING KPI CARDS (Responsive via WrapPanel) -->
            <WrapPanel HorizontalAlignment="Center" Margin="-8">
                <WrapPanel.Styles>
                    <Style Selector="Border.KpiCard">
                        <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                        <Setter Property="Padding" Value="{DynamicResource SpacingMedium}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Width" Value="280"/>
                        <Setter Property="Margin" Value="{DynamicResource SpacingSmall}"/>
                        <Setter Property="Height" Value="110"/> 
                    </Style>
                </WrapPanel.Styles>

                <!-- Card 1 -->
                <Border Classes="KpiCard">
                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="OVERALL PROGRESS" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                        <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:F1}%'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBase}"/>
                        <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="4" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource SuccessBase}" CornerRadius="2"/>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Classes="KpiCard">
                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="ACADEMIC GPA" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                        <TextBlock Text="{Binding CurrentGpa}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextAccent}"/>
                        <TextBlock Text="Top 5% Cohort Rank" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Classes="KpiCard">
                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="COMPLETED COURSES" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                        <TextBlock Text="{Binding CompletedModulesCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Across 3 Active Courses" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4 -->
                <Border Classes="KpiCard">
                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                        <TextBlock Text="ENCRYPTED OUTBOX" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                        <TextBlock Text="{Binding PendingOutboxCount, StringFormat='{}{0} Items'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WarningBase}"/>
                        <TextBlock Text="Pending Sync Queue" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 4. REFLOWING MAIN CONTENT AREAS (Alerts & Feed) -->
            <WrapPanel HorizontalAlignment="Center" Margin="-8">
                
                <!-- Column 1: Urgent Assessment Windows -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="{DynamicResource SpacingSmall}" Width="576" MinHeight="350" VerticalAlignment="Top">
                    <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                        <!-- Header with Filters -->
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Offline Assessment" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="High Priority Only" Background="{DynamicResource ErrorSubtle}" Foreground="{DynamicResource ErrorBase}" FontWeight="Medium" FontSize="{DynamicResource FontSizeCaption}" Padding="8,4" CornerRadius="{DynamicResource ButtonRadius}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Filter ▼" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}" Padding="8,4" CornerRadius="{DynamicResource ButtonRadius}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding UrgentAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dash:UrgentAlertDto">
                                    <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource InputRadius}" Padding="{DynamicResource SpacingMedium}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <Border Background="{DynamicResource ErrorSubtle}" CornerRadius="{DynamicResource BadgeRadius}" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource ErrorHover}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding TimeInfo}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Start" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BrandPrimary}" BorderThickness="1" Foreground="{DynamicResource TextAccent}" FontWeight="Bold" FontSize="{DynamicResource FontSizeMetadata}" VerticalAlignment="Center" Padding="14,8" CornerRadius="{DynamicResource BadgeRadius}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Column 2: Recent Academic Feed -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="{DynamicResource SpacingSmall}" Width="576" MinHeight="350" VerticalAlignment="Top">
                    <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                        <!-- Header with Sorting -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Recent Feed" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="Unread" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}" Padding="8,4" CornerRadius="{DynamicResource ButtonRadius}"/>
                                <Button Content="Today" Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontSize="{DynamicResource FontSizeMetadata}" Padding="8,4" CornerRadius="{DynamicResource ButtonRadius}"/>
                                <Button Content="Sort ▼" Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}" Padding="8,4" CornerRadius="{DynamicResource ButtonRadius}"/>
                            </StackPanel>
                        </Grid>
                        
                        <ItemsControl ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dash:RecentActivityDto">
                                    <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource InputRadius}" Padding="12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding ActivityName}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                                <TextBlock Text="{Binding TimestampText}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeCaption}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BgBase}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource BadgeRadius}" Padding="6,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SuccessBase}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>