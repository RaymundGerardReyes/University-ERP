<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.PackageManagerView"
             x:DataType="vm:PackageManagerViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource SpacingLargeVal}" Margin="{DynamicResource SpacingLarge}">
            <!-- Header & Download CTA -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource SpacingMicroVal}">
                    <TextBlock Text="Package Library &amp; Security" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
                    <TextBlock Text="Manage locally installed, cryptographically verified course material packages." Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="📥 Download New Package" 
                        Command="{Binding DownloadNewPackageCommand}"
                        Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" 
                        VerticalAlignment="Center" Padding="14,10" CornerRadius="{DynamicResource ButtonRadius}"/>
            </Grid>

            <!-- Status Banner -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource ButtonRadius}" Padding="14,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
            </Border>

            <!-- Storage Usage Indicator -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Local Storage Allocation (SQLCipher DB + Media Cache)" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StorageUsage}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>
                    <ProgressBar Value="{Binding StoragePercentage}" Maximum="100" Height="8" Foreground="{DynamicResource InfoBase}" Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource BadgeRadius}"/>
                </StackPanel>
            </Border>

            <!-- Installed Package Items -->
            <ItemsControl ItemsSource="{Binding InstalledPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:InstalledCoursePackageItem">
                        <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="{DynamicResource SpacingMicroVal}">
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBright}"/>
                                        <TextBlock Text="{Binding SizeFormatted, StringFormat='Version {0} • Size: {1}'}" FontSize="{DynamicResource FontSizeMetadata}" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SuccessSubtle}" BorderBrush="{DynamicResource SuccessBase}" BorderThickness="1" CornerRadius="15" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock Text="Verified &amp; Active" Foreground="{DynamicResource SuccessHover}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                    </Border>
                                </Grid>

                                <!-- Signature Details Box -->
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource ButtonRadius}" Padding="14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel Spacing="{DynamicResource SpacingSmallVal}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="SHA-256 Digest: " Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HashSignature}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}" FontFamily="Consolas"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="Status: " Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VerificationStatus}" Foreground="{DynamicResource SuccessBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingSmallVal}" HorizontalAlignment="Right">
                                    <Button Content="Verify SHA-256 Integrity" 
                                            Command="{Binding $parent[UserControl].((vm:PackageManagerViewModel)DataContext).VerifyIntegrityCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextBright}" FontWeight="SemiBold" Padding="12,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>