<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.PackageManagerView"
             x:DataType="vm:PackageManagerViewModel">

    <StackPanel Spacing="20">
        <TextBlock Text="Package Library" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Manage locally installed, cryptographically verified course packages." Foreground="#8899b8" Margin="0,0,0,20"/>

        <!-- Storage Bar -->
        <Border Background="#111d36" CornerRadius="10" Padding="20" BorderBrush="#1f2937" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Local Database Storage (SQLite)" Foreground="#8899b8"/>
                    <TextBlock Grid.Column="1" Text="{Binding StorageUsage}" Foreground="White" FontWeight="Bold"/>
                </Grid>
                <ProgressBar Value="42" Maximum="100" Height="10" Foreground="#3b82f6" Background="#0d1526" CornerRadius="5"/>
            </StackPanel>
        </Border>

        <!-- Installed Package Card -->
        <Border Background="#0d1526" CornerRadius="10" Padding="20" BorderBrush="#1f2937" BorderThickness="1">
            <StackPanel Spacing="15">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="CS-201: Object Oriented Programming" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Package v1.4.2 • Size: 1.2 GB" FontSize="12" Foreground="#8899b8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#059669" CornerRadius="15" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Installed" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <Border Background="#111d36" CornerRadius="6" Padding="15" BorderBrush="#1f2937" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Signature Status" Foreground="#8899b8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SignatureStatus}" Foreground="#34d399" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Incremental Update" Foreground="#8899b8" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="2 hours ago" Foreground="White" Margin="0,10,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Verify Integrity" Background="Transparent" BorderBrush="#1f2937" BorderThickness="1" Foreground="White"/>
                    <Button Content="Launch Course" Background="#3b82f6" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>