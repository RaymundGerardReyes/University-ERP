<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LmsOffline.Presentation.ViewModels"
             x:Class="LmsOffline.Presentation.Views.CourseContentView"
             x:DataType="vm:CourseContentViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource SpacingLargeVal}" Margin="{DynamicResource SpacingLarge}">
            <!-- Header Section -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <Border Background="{DynamicResource InfoSubtle}" BorderBrush="{DynamicResource InfoBase}" BorderThickness="1" CornerRadius="{DynamicResource BadgeRadius}" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CourseCode}" Foreground="{DynamicResource InfoHover}" FontWeight="Bold" FontSize="{DynamicResource FontSizeMetadata}"/>
                        </Border>
                        <TextBlock Text="{Binding ModuleTitle}" FontSize="{DynamicResource FontSizeSectionTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBright}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{Binding CompletionBadge}" 
                            Command="{Binding ToggleCompletionCommand}"
                            Background="{DynamicResource BgPanel}" Foreground="{DynamicResource InfoBase}" FontWeight="Bold" 
                            VerticalAlignment="Center" Padding="14,10" CornerRadius="{DynamicResource ButtonRadius}"/>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <TextBlock IsVisible="{Binding IsLoading}" 
                       Text="Decrypting offline materials from SQLCipher vault..." 
                       Foreground="{DynamicResource InfoBase}" FontStyle="Italic" FontSize="{DynamicResource FontSizeBody}"/>

            <!-- Lesson Body Card -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                    <TextBlock Text="Lesson Content &amp; Lecture Notes" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource InfoHover}"/>

                    <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource ButtonRadius}" Padding="{DynamicResource SpacingMedium}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <TextBlock Text="{Binding TextContent}" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   TextWrapping="Wrap" 
                                   FontSize="{DynamicResource FontSizeBody}" 
                                   LineHeight="22" 
                                   FontFamily="Segoe UI, Inter, sans-serif"/>
                    </Border>

                    <TextBlock Text="Downloaded Resources &amp; Code Samples:" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeBody}"/>
                    <StackPanel Spacing="8">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource BadgeRadius}" Padding="12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="📄 Polymorphism_Code_Examples.cs (32 KB)" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                <TextBlock Grid.Column="1" Text="Open File" Foreground="{DynamicResource InfoBase}" FontSize="{DynamicResource FontSizeMetadata}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>