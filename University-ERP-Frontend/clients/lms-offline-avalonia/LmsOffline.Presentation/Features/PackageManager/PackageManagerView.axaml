<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pmVm="using:LmsOffline.Presentation.Features.PackageManager"
             x:Class="LmsOffline.Presentation.Features.PackageManager.PackageManagerView"
             x:DataType="pmVm:PackageManagerViewModel"
             Background="{DynamicResource BgBase}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource SpacingLargeVal}" Margin="{DynamicResource SpacingLarge}">
            
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource SpacingMicroVal}">
                    <TextBlock Text="Offline Course Materials" FontSize="{DynamicResource FontSizePageTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
                    <TextBlock Text="Manage your downloaded lessons and learning resources for offline use." Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Check Delta Packages"
                        Command="{Binding DownloadNewPackageCommand}"
                        IsEnabled="{Binding !IsDownloading}"
                        Background="{DynamicResource BrandPrimary}" Foreground="{DynamicResource TextBright}" FontWeight="Bold"
                        VerticalAlignment="Center" Padding="14,10" CornerRadius="{DynamicResource ButtonRadius}"/>
            </Grid>

            <!-- Storage Indicator Card -->
            <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Device Storage Used" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StorageUsage}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>
                    <ProgressBar Value="{Binding StoragePercentage}" Maximum="100" Height="8" Foreground="{DynamicResource InfoBase}" Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource BadgeRadius}"/>
                </StackPanel>
            </Border>

            <!-- Download Progress Indicator (Visible when downloading delta sync packages) -->
            <Border IsVisible="{Binding IsDownloading}" Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BrandPrimary}" BorderThickness="1.5">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding DownloadProgressText}" Foreground="{DynamicResource BrandPrimary}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DownloadProgress, StringFormat='{}{0}%'}" Foreground="{DynamicResource TextBright}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"/>
                    </Grid>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8" Foreground="{DynamicResource BrandPrimary}" Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource BadgeRadius}"/>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource ButtonRadius}" Padding="12,10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource FontSizeMetadata}" HorizontalAlignment="Center"/>
            </Border>

            <ItemsControl ItemsSource="{Binding InstalledPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="pmVm:InstalledCoursePackageItem">
                        <Border Background="{DynamicResource BgSurface}" CornerRadius="{DynamicResource CardRadius}" Padding="{DynamicResource SpacingLarge}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel Spacing="{DynamicResource SpacingMediumVal}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="{DynamicResource SpacingMicroVal}">
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="Medium" Foreground="{DynamicResource TextBright}"/>
                                        <TextBlock Text="{Binding SizeFormatted, StringFormat='Version {0}   Size: {1}'}" FontSize="{DynamicResource FontSizeMetadata}" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SuccessSubtle}" BorderBrush="{DynamicResource SuccessBase}" BorderThickness="1" CornerRadius="15" Padding="12,5" VerticalAlignment="Center">
                                        <TextBlock Text="Ready for Offline Use" Foreground="{DynamicResource SuccessHover}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                    </Border>
                                </Grid>

                                <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource ButtonRadius}" Padding="14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="{DynamicResource SpacingMicroVal}">
                                            <TextBlock Text="{Binding HashSignature, StringFormat='SHA-256: {0}'}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource FontSizeMetadata}"/>
                                            <TextBlock Text="{Binding VerificationStatus}" Foreground="{DynamicResource SuccessBase}" FontSize="{DynamicResource FontSizeMetadata}" FontWeight="Medium"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Verify SHA-256"
                                                Command="{Binding ((pmVm:PackageManagerViewModel)DataContext).VerifyIntegrityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4" FontSize="11" CornerRadius="4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
