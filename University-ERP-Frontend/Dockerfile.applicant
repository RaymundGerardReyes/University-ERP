# -----------------------------------------------------------------------------
# University ERP - Applicant Portal Data Container
# -----------------------------------------------------------------------------
# This Dockerfile builds ONLY the Applicant portal and produces a lightweight,
# immutable Alpine image containing the static assets.
# -----------------------------------------------------------------------------

FROM node:22-alpine AS builder

WORKDIR /app
# Copy workspace manifests first to leverage Docker layer caching
COPY package.json package-lock.json* ./
COPY apps/admin-portal/package.json ./apps/admin-portal/
COPY apps/admissions-portal/package.json ./apps/admissions-portal/
COPY apps/applicant-portal/package.json ./apps/applicant-portal/
COPY apps/faculty-portal/package.json ./apps/faculty-portal/
COPY apps/finance-console/package.json ./apps/finance-console/
COPY apps/governance-console/package.json ./apps/governance-console/
COPY apps/identity-portal/package.json ./apps/identity-portal/
COPY apps/library-portal/package.json ./apps/library-portal/
COPY apps/lms-web/package.json ./apps/lms-web/
COPY apps/platform-console/package.json ./apps/platform-console/
COPY apps/registrar-portal/package.json ./apps/registrar-portal/
COPY apps/security-portal/package.json ./apps/security-portal/
COPY apps/student-portal/package.json ./apps/student-portal/
COPY libs/api-clients/package.json ./libs/api-clients/
COPY libs/auth-sdk/package.json ./libs/auth-sdk/
COPY libs/core-logger/package.json ./libs/core-logger/
COPY libs/domain-viewmodels/package.json ./libs/domain-viewmodels/
COPY libs/shell-kit/package.json ./libs/shell-kit/
COPY libs/ui-kit/package.json ./libs/ui-kit/
COPY libs/vite-config/package.json ./libs/vite-config/
COPY libs/workflow-sdk/package.json ./libs/workflow-sdk/

# Install dependencies before copying source code
RUN npm install

# Copy the rest of the source code
COPY . .

# Accept build arguments
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_AUTH_AUTHORITY
ENV VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY
ARG VITE_APPLICANT_PORTAL_URL
ENV VITE_APPLICANT_PORTAL_URL=$VITE_APPLICANT_PORTAL_URL

# Build ONLY the applicant-portal
RUN npm run build --workspace=apps/applicant-portal

# -----------------------------------------------------------------------------
# Stage 2: Immutable Data Image
# -----------------------------------------------------------------------------
FROM alpine:latest

# Copy only the compiled assets from the builder stage
COPY --from=builder /app/apps/applicant-portal/dist /app-data

# The data container copies its assets to the Nginx shared volume and exits
CMD cp -a /app-data/. /var/www/applicant-portal/ && echo "✅ Applicant Portal assets delivered."
