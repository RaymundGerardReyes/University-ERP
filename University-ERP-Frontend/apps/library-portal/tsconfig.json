{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shell/*": ["src/shell/*"],
      "@features/*": ["src/features/*"],
      "@state/*": ["src/state/*"],
      "@config/*": ["src/config/*"],
      "@university-erp/domain-viewmodels": ["../../libs/domain-viewmodels/index.ts"],
      "@university-erp/api-clients": ["../../libs/api-clients/index.ts"],
      "@university-erp/ui-kit": ["../../libs/ui-kit/index.ts"],
      "@university-erp/auth-sdk": ["../../libs/auth-sdk/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
